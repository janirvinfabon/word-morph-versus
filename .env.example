# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored so your Worker URL is not committed to the repo.
#
# NOTE: the Worker URL is an endpoint, not a secret — once the frontend is
# deployed it is visible in the shipped static files. Keeping it in .env only
# prevents it from living in the git repository.

# Base URL of your deployed Cloudflare Worker (no trailing slash).
WS_URL=https://your-worker-name.your-subdomain.workers.dev

# Cloudflare Pages project name for the frontend deploy.
PAGES_PROJECT=word-morph-versus
